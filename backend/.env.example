# Copie este arquivo para backend/.env e preencha

# Token do @BotFather
TELEGRAM_TOKEN=

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
# Sem ela o bot funciona em "modo só YOLO" (respostas prontas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Reserva se o principal estiver sobrecarregado (rode o comando de listar modelos pra escolher)
GEMINI_MODELOS_RESERVA=

# Demo: retorno proativo em 60 segundos (na vida real seriam dias)
FOLLOWUP_SEGUNDOS=60

# Surto = MIN_CASOS_SURTO casos da mesma praga num raio de RAIO_SURTO_KM
MIN_CASOS_SURTO=3
RAIO_SURTO_KM=10

# sempre | auto (só quando o produtor manda áudio) | nunca
RESPOSTA_EM_AUDIO=auto

# Link que o comando /painel manda
PAINEL_URL=http://localhost:5173
